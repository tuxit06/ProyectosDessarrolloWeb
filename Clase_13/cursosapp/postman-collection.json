{
  "info": {
    "name": "SC-403 - Proyecto base canonico (cursosapp)",
    "_postman_id": "sc403-cursosapp-base-collection",
    "description": "Coleccion de peticiones para probar el proyecto base canonico del curso (cursosapp).\n\nIncluye:\n- Endpoints de Cursos (CRUD completo con MySQL/JPA)\n- Variables: usar {{base_url}} para cambiar de localhost al server desplegado\n\nImportar desde Postman:\nFile -> Import -> seleccionar este .json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Home",
      "description": "Pagina de inicio. Acepta ?nombre= opcional.",
      "item": [
        {
          "name": "GET / (sin parametro)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Pagina de inicio con el saludo por defecto (\"Estudiante\")."
          },
          "response": []
        },
        {
          "name": "GET / con ?nombre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/?nombre=Esteban",
              "host": ["{{base_url}}"],
              "path": [""],
              "query": [
                {
                  "key": "nombre",
                  "value": "Esteban",
                  "description": "Nombre a saludar"
                }
              ]
            },
            "description": "Pagina de inicio con saludo personalizado."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cursos",
      "description": "Listado y detalle de cursos.",
      "item": [
        {
          "name": "GET /cursos (listar)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cursos",
              "host": ["{{base_url}}"],
              "path": ["cursos"]
            },
            "description": "Lista todos los cursos. Antes del refactor: vienen de memoria. Despues: vienen de MySQL via JpaRepository.findAll()."
          },
          "response": []
        },
        {
          "name": "GET /cursos/1 (detalle - existente)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cursos/1",
              "host": ["{{base_url}}"],
              "path": ["cursos", "1"]
            },
            "description": "Detalle del curso ID=1 (Fundamentos Web)."
          },
          "response": []
        },
        {
          "name": "GET /cursos/2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cursos/2",
              "host": ["{{base_url}}"],
              "path": ["cursos", "2"]
            },
            "description": "Detalle del curso ID=2 (Spring Boot)."
          },
          "response": []
        },
        {
          "name": "GET /cursos/999 (caso 'no encontrado')",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/cursos/999",
              "host": ["{{base_url}}"],
              "path": ["cursos", "999"]
            },
            "description": "Caso 'no encontrado'. La vista muestra un alert warning de Bootstrap."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Demo en clase",
      "description": "Peticiones utiles para mostrar conceptos en vivo.",
      "item": [
        {
          "name": "Ver headers de respuesta",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "url": {
              "raw": "{{base_url}}/cursos",
              "host": ["{{base_url}}"],
              "path": ["cursos"]
            },
            "description": "Mostrar a los estudiantes los headers de respuesta: Content-Type, Content-Length, etc. Ir a la pestana 'Headers' del response."
          },
          "response": []
        },
        {
          "name": "Probar 404 explicito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/no-existe",
              "host": ["{{base_url}}"],
              "path": ["no-existe"]
            },
            "description": "Ruta inexistente. Spring Boot devuelve la 'Whitelabel Error Page' con status 404."
          },
          "response": []
        },
        {
          "name": "Metodo no permitido (POST a GET)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": ""
            },
            "url": {
              "raw": "{{base_url}}/cursos",
              "host": ["{{base_url}}"],
              "path": ["cursos"]
            },
            "description": "Demuestra status 405 Method Not Allowed: el endpoint /cursos solo acepta GET."
          },
          "response": []
        }
      ]
    },
    {
      "name": "API REST (JSON)",
      "description": "Endpoints /api/cursos - @RestController, JSON, ResponseEntity. Publicos (sin login) en esta clase - ver SecurityConfig.",
      "item": [
        {
          "name": "GET /api/cursos (listar - JSON)",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{base_url}}/api/cursos",
              "host": ["{{base_url}}"],
              "path": ["api", "cursos"]
            },
            "description": "Lista de cursos en JSON (usa listarConProfesor() - JOIN FETCH, sin proxies LAZY sin resolver)."
          },
          "response": []
        },
        {
          "name": "GET /api/cursos/1 (detalle - JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cursos/1",
              "host": ["{{base_url}}"],
              "path": ["api", "cursos", "1"]
            },
            "description": "200 OK con el curso, o 404 si no existe."
          },
          "response": []
        },
        {
          "name": "GET /api/cursos/999 (404 JSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cursos/999",
              "host": ["{{base_url}}"],
              "path": ["api", "cursos", "999"]
            },
            "description": "Curso inexistente - devuelve 404 sin body (ResponseEntity.notFound().build())."
          },
          "response": []
        },
        {
          "name": "POST /api/cursos (crear)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Testing con Postman\",\n  \"descripcion\": \"Curso creado desde la API REST\",\n  \"creditos\": 3,\n  \"profesor\": { \"id\": 1 }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/cursos",
              "host": ["{{base_url}}"],
              "path": ["api", "cursos"]
            },
            "description": "201 Created + header Location con la URL del nuevo curso. Solo hace falta el id del profesor, no todos sus datos."
          },
          "response": []
        },
        {
          "name": "PUT /api/cursos/1 (actualizar)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Fundamentos Web (actualizado)\",\n  \"descripcion\": \"Descripcion actualizada via API REST\",\n  \"creditos\": 4,\n  \"profesor\": { \"id\": 1 }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/cursos/1",
              "host": ["{{base_url}}"],
              "path": ["api", "cursos", "1"]
            },
            "description": "200 OK con el curso actualizado, o 404 si el id no existe."
          },
          "response": []
        },
        {
          "name": "DELETE /api/cursos/{id} (eliminar)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/cursos/6",
              "host": ["{{base_url}}"],
              "path": ["api", "cursos", "6"]
            },
            "description": "204 No Content si se borro, 404 si no existia. Cambiar el id por uno que exista antes de probar."
          },
          "response": []
        },
        {
          "name": "POST /api/cursos (400 - validacion)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"creditos\": 20\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/cursos",
              "host": ["{{base_url}}"],
              "path": ["api", "cursos"]
            },
            "description": "Demuestra 400 Bad Request: nombre vacio (@NotBlank), creditos fuera de rango (@Max 8) y sin profesor (@NotNull)."
          },
          "response": []
        }
      ]
    },
